package build.core.layout

import build.*
import mill.*
import mill.javalib.*
import mill.javalib.publish.*

object `package` extends Gui4sPackage:
  def pomDescription = "layout"

  def mvnDeps = super.mvnDeps() ++ build.dependencies.cats

  def moduleDeps = super.moduleDeps ++ Seq(build.catnip, build.core.geometry)

  object test extends ScalaTests with TestModule.ScalaTest:
    def mvnDeps = super.mvnDeps() ++ build.dependencies.test
    def testSandboxWorkingDir = false
  end test
end `package`
package build.desktop.windowing.glfw

import build.*
import coursier.Repository
import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import build.dependencies.catsEffect
import com.goyeau.mill.scalafix.ScalafixModule

object `package` extends Gui4sPackage:
  def artifactName = "desktop-glfw-windowing"

  def mvnDeps: T[Seq[Dep]] =
    super.mvnDeps() ++ catsEffect ++ build.dependencies.glfw4s ++ build.dependencies.scalaCache
  end mvnDeps

  def moduleDeps: Seq[PublishModule] =
    Seq(build.desktop.kit)
  end moduleDeps

  override def pomDescription: String =
    "GLFW4s based windowing for Gui4s"
  end pomDescription
end `package`
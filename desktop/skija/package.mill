package build.desktop.skija

import build.*
import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalalib.{AssemblyModule, SbtModule}
import build.dependencies.catsEffect

object `package` extends SbtModule with Gui4sPackage with AssemblyModule:
  override def artifactName = "desktop-skija-bindings"

  override def pomDescription = "desktop-skija-bindings"

  override def repositoriesTask = Task.Anon:
    super.repositoriesTask() ++ Seq(coursier.LocalRepositories.ivy2Local)

  override def mvnDeps = super.mvnDeps() ++ build.dependencies.skija ++ catsEffect

  override def moduleDeps = super.moduleDeps ++ Seq(build.catnip, build.core.layout)
end `package`
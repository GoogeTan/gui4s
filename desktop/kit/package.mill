package build.desktop.kit

import build.*
import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalalib.SbtModule
import build.dependencies.catsEffect

object `package` extends SbtModule with Gui4sPackage:
  override def artifactName = "desktop-kit"

  override def pomDescription = "desktop-kit"

  override def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ catsEffect ++ build.dependencies.scalaCache

  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(
    build.catnip,
    build.core.kit,
    build.core.layout,
    build.core.loop,
    build.core.widget,
    build.core.widgetLibrary,
    build.desktop.skija,
    build.desktop.widgetLibrary
  )
end `package`
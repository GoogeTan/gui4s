package build.desktop.example.glfw

import build.*
import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalalib.AssemblyModule
import mill.util.JarManifest

object `package` extends Gui4sPackage with AssemblyModule:
  override def artifactName = "desktop-example-glfw"

  override def pomDescription = "desktop-example-cats"

  override def scalacOptions = super.scalacOptions() ++ Seq("-Vprofile")

  override def mvnDeps = super.mvnDeps() ++ build.dependencies.http4s ++ build.dependencies.logging

  override def forkArgs = Seq("-XstartOnFirstThread")

  override def moduleDeps = super.moduleDeps ++ Seq(build.desktop.example.shared, build.desktop.windowing.glfw)

  override def mainClass = Some("gui4s.desktop.example.glfw.ScenedExample")

  override def manifest: T[JarManifest] = Task:
    super.manifest().add("Multi-Release" -> "true")
end `package`
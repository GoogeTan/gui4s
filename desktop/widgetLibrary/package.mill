package build.desktop.widgetLibrary

import build.*
import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.scalalib.SbtModule
import com.goyeau.mill.scalafix.ScalafixModule

object `package` extends Gui4sPackage:
  override def artifactName = "desktop-widget-library"

  override def mvnDeps =
    build.dependencies.cats
  end mvnDeps

  override def moduleDeps: Seq[PublishModule] =
    super.moduleDeps ++ Seq(
      build.core.loop,
      build.core.widgetLibrary
    )
  end moduleDeps

  override def pomDescription: String =
    "Library of widgets for Gui4s"
  end pomDescription

  object test extends ScalaTests with TestModule.ScalaTest:
    override def mvnDeps = super.mvnDeps() ++ build.dependencies.test

    override def moduleDeps = super.moduleDeps ++ Seq(build.core.kit)
  end test
end `package`
